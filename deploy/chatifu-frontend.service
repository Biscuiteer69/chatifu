[Unit]
Description=ChatIFU static frontend
After=network.target

[Service]
# Serves frontend/ (index.html) on 127.0.0.1:8080 for the Cloudflare Tunnel.
WorkingDirectory=/home/biscuited/projects/chatifu_vault/frontend
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
